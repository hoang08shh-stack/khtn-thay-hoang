        "lessonUpdatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "assets": {
          "type": "array"
        },
        "coreWordDoc": {
          "type": "object"
        },
        "simulationIds": {
          "type": "array"
        },
        "miniQuiz": {
          "type": "array"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
