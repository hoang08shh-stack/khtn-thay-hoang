  "firestore": {
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminRegistry"
      },
      "description": "Private RBAC registry of authorized teacher/admin UIDs."
    },
    "/cms_meta/{metaId}": {
      "schema": {
        "$ref": "#/entities/CmsMeta"
      },
      "description": "Global CMS sync revision, site settings, and deletion tombstones (document ID: live)."
    },
    "/cms_lessons/{lessonId}": {
      "schema": {
        "$ref": "#/entities/CmsLesson"
      },
      "description": "All KHTN 6-9 lessons including Core Word Reader HTML, attachments, and mini-quizzes."
    },
    "/cms_topics/{topicId}": {
      "schema": {
        "$ref": "#/entities/CmsTopic"
      },
      "description": "Curriculum topics/chapters for Grades 6-9."
    },
    "/cms_videos/{videoId}": {
      "schema": {
        "$ref": "#/entities/CmsVideo"
      },
      "description": "Experiment and lecture videos."
    },
    "/cms_catalog_docs/{docId}": {
      "schema": {
        "$ref": "#/entities/CmsCatalogDoc"
      },
      "description": "Catalog documents (PPTX, PDF, DOCX) for student downloads."
    },
    "/cms_resources/{resourceId}": {
      "schema": {
        "$ref": "#/entities/CmsResource"
      },
      "description": "Unified learning resources, general uploaded assets, and custom curriculum entries."
    },
    "/cms_questions/{questionId}": {
      "schema": {
        "$ref": "#/entities/CmsQuestion"
      },
      "description": "Practice question bank items."
    },
    "/cms_quizzes/{quizId}": {
      "schema": {
        "$ref": "#/entities/CmsQuiz"
      },
      "description": "Online quiz metadata definitions."
    }
  }
}
