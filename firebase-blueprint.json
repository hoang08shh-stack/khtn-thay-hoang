          "type": "string",
          "maxLength": 120000
        },
        "durationMinutes": {
          "type": "number"
        },
        "orderIndex": {
          "type": "number"
        },
        "isPublished": {
          "type": "boolean"
        },
        "isPublic": {
          "type": "boolean"
        },
        "thumbnailUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "viewCount": {
          "type": "number"
        },
        "lessonCreatedAt": {
          "type": "string",
          "maxLength": 64
