import type { Grade, QuestionType, SubjectDomain } from '../types/index.ts';

export interface SolutionInput {
  question: string;
  options: string[];
  correctAnswer?: number;
  questionType?: QuestionType;
  domain: SubjectDomain;
  grade: Grade;
  existingExplanation?: string;
}

export interface ScientificSolution {
  steps: string[];
  explanation: string;
  status: 'solved' | 'provided' | 'needs_review';
  warnings: string[];
  inferredAnswer: number | null;
}

type Result = { value: number; unit: string };
type Work = { steps: string[]; results?: Result[]; matches?: (option: string) => boolean; warning?: string };
const numberPattern = '([-+]?\\d+(?:[.,]\\d+)?)';
const num = (s: string) => Number(s.replace(',', '.'));
const fmt = (n: number) => Number(n.toPrecision(8)).toString().replace('.', ',');
const plain = (s: string) => s.normalize('NFKC').replace(/−/g, '-');
const close = (a: number, b: number) => Math.abs(a - b) <= Math.max(1e-8, Math.abs(b) * 0.0005);
const review = (warning: string): Work => ({ steps: [], warning });
const step = (title: string, text: string) => `${title}: ${text}`;
const hasSymbol = (text: string, symbol: string) => new RegExp(`(?<![\\p{L}\\p{N}_])${symbol}(?![\\p{L}\\p{N}_])`, 'u').test(text);

// Read a single, explicitly labelled physical quantity. Repeated conflicting values
// are ambiguous and must never silently become the first number in the document.
function quantity(q: string, label: string, units: Record<string, number>): number | null {
  const unitPattern = Object.keys(units).sort((a, b) => b.length - a.length)
    .map(u => u.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
  const re = new RegExp(`(?:^|[^\\p{L}\\p{N}_])(?:${label})\\s*(?:=|là|bằng|:)\\s*${numberPattern}\\s*(${unitPattern})(?![\\p{L}\\p{N}²³/])`, 'giu');
  const values = [...q.matchAll(re)].map(m => num(m[1]) * units[m[2].toLowerCase()]);
  return values.length && values.every(v => close(v, values[0])) ? values[0] : null;
}

function request(q: string): string {
  return q.match(/(?:tính|xác định|hãy tìm)([\s\S]*)$/i)?.[1] || q.split(/(?<=[.?!])\s+/).filter(Boolean).at(-1) || q;
}

function electrical(q: string): Work | null {
  if (!/điện trở|cường độ dòng điện|hiệu điện thế|ohm|mạch điện|công suất điện/i.test(q)) return null;
  const U = quantity(q, 'U|hiệu điện thế', { kv: 1000, mv: 0.001, v: 1 });
  const R1 = quantity(q, 'R1', { 'kω': 1000, 'ω': 1, ohm: 1 });
  const R2 = quantity(q, 'R2', { 'kω': 1000, 'ω': 1, ohm: 1 });
  const singleR = quantity(q, 'R|điện trở', { 'kω': 1000, 'ω': 1, ohm: 1 });
  const givenI = quantity(q, 'I|cường độ dòng điện', { ma: 0.001, a: 1 });
  const tMatch = q.match(new RegExp(`${numberPattern}\\s*(phút|giây|s|giờ)(?!\\p{L})`, 'iu'));
  const t = tMatch ? num(tMatch[1]) * ({ phút: 60, giây: 1, s: 1, giờ: 3600 }[tMatch[2].toLowerCase()] || 1) : null;
  const ask = request(q);
  const pair = R1 !== null || R2 !== null;
  if (/R[3-9]|hỗn hợp|biến trở|điện trở trong/i.test(q)) return review('Mạch có cấu trúc phức tạp; cần sơ đồ và cách nối đầy đủ để lập lời giải.');
  if (pair && (R1 === null || R2 === null || !/nối tiếp|song song/i.test(q) || /nối tiếp/i.test(q) && /song song/i.test(q))) {
    return review('Cần đủ R₁, R₂ và xác định rõ mắc nối tiếp hay song song; không tự giả định cách mắc.');
  }
  if ([singleR, R1, R2].some(v => v !== null && v <= 0) || U !== null && U < 0 || givenI !== null && givenI < 0 || t !== null && t <= 0) {
    return review('Điện trở và thời gian phải dương; kiểm tra lại dấu, giá trị và đơn vị trong đề.');
  }
  const parallel = /song song/i.test(q);
  const derivedR = !pair && singleR === null && U !== null && givenI !== null && givenI > 0;
  const R = pair ? (parallel ? R1! * R2! / (R1! + R2!) : R1! + R2!) : derivedR ? U! / givenI! : singleR;
  if (R === null || U === null && givenI === null) return review('Chưa đọc đủ dữ kiện điện học. Hãy ghi rõ U = … V, R = … Ω hoặc I = … A; kiểm tra cả dữ kiện trong hình.');
  if (R <= 0) return review('Điện trở suy ra phải dương trong mô hình dây dẫn đang xét; cần kiểm tra lại U và I.');
  const voltage = U ?? givenI! * R;
  const I = voltage / R;
  if (givenI !== null && !close(givenI, I)) return review('Các dữ kiện U, I, R không thỏa U = I × R; cần kiểm tra đề trước khi giải.');
  const steps = [
    `Dữ kiện: ${pair ? `R₁ = ${fmt(R1!)} Ω | R₂ = ${fmt(R2!)} Ω | Mắc ${parallel ? 'song song' : 'nối tiếp'}` : derivedR ? `I = ${fmt(givenI!)} A` : `R = ${fmt(R!)} Ω`} | ${U !== null ? `U = ${fmt(U)} V` : `I = ${fmt(givenI!)} A`}${t !== null ? ` | t = ${fmt(t)} s` : ''}`,
  ];
  if (pair) steps.push(step('Điện trở tương đương', parallel
    ? `Hai nhánh có cùng hiệu điện thế, còn dòng mạch chính bằng tổng dòng các nhánh.\n[EQ] R_{tđ} = \\frac{R₁ × R₂}{R₁ + R₂} = \\frac{${fmt(R1!)} × ${fmt(R2!)}}{${fmt(R1!)} + ${fmt(R2!)}} = ${fmt(R!)} Ω`
    : `Dòng điện đi lần lượt qua hai điện trở; hiệu điện thế toàn mạch bằng tổng hiệu điện thế hai phần.\n[EQ] R_{tđ} = R₁ + R₂ = ${fmt(R1!)} + ${fmt(R2!)} = ${fmt(R!)} Ω`));
  steps.push(step('Áp dụng định luật Ohm', derivedR
    ? `Từ I = U/R, nhân hai vế với R rồi chia cho I (I > 0). Đơn vị V/A là Ω.\n[EQ] R = \\frac{U}{I} = \\frac{${fmt(U!)}}{${fmt(givenI!)}} = ${fmt(R)} Ω`
    : U !== null
    ? `Dùng điện trở của đúng đoạn mạch đang xét; V/Ω cho đơn vị A.\n[EQ] I = \\frac{U}{${pair ? 'R_{tđ}' : 'R'}} = \\frac{${fmt(voltage)}}{${fmt(R!)}} = ${fmt(I)} A`
    : `Hiệu điện thế bằng tích cường độ dòng điện và điện trở.\n[EQ] U = I × R = ${fmt(I)} × ${fmt(R!)} = ${fmt(voltage)} V`));
  if (pair && /mỗi|từng|I1|I2|U1|U2/i.test(ask)) steps.push(step('Đại lượng trên từng điện trở', parallel
    ? `[EQ] U₁ = U₂ = U = ${fmt(voltage)} V\n[EQ] I₁ = U/R₁ = ${fmt(voltage / R1!)} A ; I₂ = U/R₂ = ${fmt(voltage / R2!)} A\nKiểm tra: I₁ + I₂ = ${fmt(I)} A.`
    : `[EQ] I₁ = I₂ = I = ${fmt(I)} A\n[EQ] U₁ = I × R₁ = ${fmt(I * R1!)} V ; U₂ = I × R₂ = ${fmt(I * R2!)} V\nKiểm tra: U₁ + U₂ = ${fmt(voltage)} V.`));
  const results: Result[] = [];
  if (/điện trở tương đương|R_?\{?tđ/i.test(ask) || !pair && (/điện trở/i.test(ask) || hasSymbol(ask, 'R'))) results.push({ value: R!, unit: 'Ω' });
  if ((/cường độ|dòng điện/i.test(ask) || hasSymbol(ask, 'I')) && !/mỗi|từng|I1|I2/i.test(ask)) results.push({ value: I, unit: 'A' });
  if ((/hiệu điện thế/i.test(ask) || hasSymbol(ask, 'U')) && !/mỗi|từng|U1|U2/i.test(ask)) results.push({ value: voltage, unit: 'V' });
  if (/công suất/i.test(ask) || hasSymbol(ask, 'P')) {
    steps.push(step('Công suất của toàn đoạn mạch', `Công suất là điện năng tiêu thụ trong một giây.\n[EQ] P = U × I = ${fmt(voltage)} × ${fmt(I)} = ${fmt(voltage * I)} W`));
    results.push({ value: voltage * I, unit: 'W' });
  }
  if (/nhiệt lượng|điện năng/i.test(ask) || hasSymbol(ask, 'Q')) {
    if (t === null) return review('Cần thời gian sử dụng để tính nhiệt lượng hoặc điện năng; ghi t bằng giây, phút hoặc giờ.');
    steps.push(step('Nhiệt lượng và điện năng trên điện trở', `Với đoạn mạch chỉ gồm điện trở, điện năng chuyển thành nhiệt. Đổi thời gian sang giây trước khi thay số.\n[EQ] Q = U × I × t = ${fmt(voltage)} × ${fmt(I)} × ${fmt(t)} = ${fmt(voltage * I * t)} J`));
    results.push({ value: voltage * I * t, unit: 'J' });
  }
  steps.push(step('Kiểm tra', `U = I × R = ${fmt(I)} × ${fmt(R!)} ≈ ${fmt(voltage)} V.${pair ? (parallel ? ' R tương đương nhỏ hơn mỗi điện trở nhánh.' : ' R tương đương lớn hơn mỗi điện trở thành phần.') : ''} Chỉ làm tròn ở kết quả cuối.`));
  return { steps, results, warning: /mỗi|từng|I1|I2|U1|U2/i.test(ask) && /công suất|nhiệt lượng/i.test(ask) ? 'Đề yêu cầu kết quả từng nhánh; phần tính P, Q trên đây là cho toàn mạch, cần bổ sung kết quả từng nhánh.' : !results.length && !/mỗi|từng|I1|I2|U1|U2/i.test(ask) ? 'Cần xác định rõ đại lượng đề yêu cầu; các phép tính trên chưa đủ để kết luận bài toán.' : undefined };
}

function mechanics(q: string): Work | null {
  if (/tốc độ|quãng đường|chuyển động đều/i.test(q)) {
    // A unit boundary prevents accidentally reading 36 km/h as a distance.
    const distances = [...q.matchAll(new RegExp(`${numberPattern}\\s*(km|m)(?![\\p{L}\\d/²³])`, 'giu'))];
    const times = [...q.matchAll(new RegExp(`${numberPattern}\\s*(phút|giây|giờ|s|h)(?![\\p{L}\\d/])`, 'giu'))];
    if (distances.length > 1 || times.length > 1) return review('Đề có nhiều quãng đường hoặc thời gian. Cần xác định từng khoảng và tổng của chúng; không lấy riêng cặp số đầu tiên làm kết quả toàn hành trình.');
    const sMatch = distances[0];
    const tMatch = times[0];
    if (!sMatch || !tMatch || /chặng|giai đoạn|nghỉ|gia tốc/i.test(q)) return review('Cần xác định tổng quãng đường và tổng thời gian (kể cả thời gian nghỉ nếu có); chưa đủ dữ kiện để tính một tốc độ duy nhất.');
    const s = num(sMatch[1]) * (sMatch[2].toLowerCase() === 'km' ? 1000 : 1);
    const t = num(tMatch[1]) * ({ phút: 60, giây: 1, giờ: 3600, s: 1, h: 3600 }[tMatch[2].toLowerCase()] || 1);
    if (s < 0 || t <= 0) return review('Quãng đường phải không âm và thời gian phải lớn hơn 0.');
    const v = s / t;
    return { steps: [
      `Dữ kiện: s = ${sMatch[0]} = ${fmt(s)} m | t = ${tMatch[0]} = ${fmt(t)} s`,
      step('Chọn công thức', 'Tốc độ trung bình bằng tổng quãng đường chia tổng thời gian; không lấy trung bình cộng các tốc độ.\n[EQ] v = \\frac{s}{t}'),
      step('Thay số và đổi đơn vị', `[EQ] v = \\frac{${fmt(s)}}{${fmt(t)}} = ${fmt(v)} m/s\n[EQ] v = ${fmt(v)} × 3,6 = ${fmt(v * 3.6)} km/h`),
      step('Kiểm tra và kết luận', `v × t ≈ ${fmt(s)} m, khớp quãng đường đề cho. Tốc độ trung bình là ${fmt(v)} m/s (${fmt(v * 3.6)} km/h).`),
    ], results: [{ value: v, unit: 'm/s' }], warning: !/tốc độ|vận tốc/i.test(request(q)) ? 'Phép tính trên tìm tốc độ; yêu cầu khác của bài cần giáo viên bổ sung.' : undefined };
  }
  if (/áp suất|áp lực/i.test(q)) {
    const F = quantity(q, 'F|áp lực', { n: 1, kn: 1000 });
    const S = quantity(q, 'S|diện tích', { m2: 1, cm2: 0.0001, mm2: 0.000001 });
    if (F === null || S === null || F < 0 || S <= 0 || /chất lỏng|độ sâu|thủy tĩnh/i.test(q)) return review('Cần áp lực vuông góc F và diện tích tiếp xúc S dương để dùng p = F/S; áp suất chất lỏng cần công thức riêng.');
    const p = F / S;
    return { steps: [
      `Dữ kiện: F = ${fmt(F)} N | S = ${fmt(S)} m²`,
      step('Đổi đơn vị và chọn công thức', '1 cm² = 0,0001 m²; 1 mm² = 0,000001 m². Áp suất là áp lực trên một đơn vị diện tích.\n[EQ] p = \\frac{F}{S}'),
      step('Thay số', `[EQ] p = \\frac{${fmt(F)}}{${fmt(S)}} = ${fmt(p)} Pa`),
      step('Kiểm tra và kết luận', `1 Pa = 1 N/m²; p × S = ${fmt(F)} N khớp áp lực. Áp suất là ${fmt(p)} Pa.`),
    ], results: [{ value: p, unit: 'Pa' }], warning: !/áp suất/i.test(request(q)) ? 'Phép tính trên tìm áp suất; cần bổ sung lời giải cho đại lượng đề yêu cầu.' : undefined };
  }
  return null;
}

function chemistry(q: string): Work | null {
  if (!/(?:HCl|H2SO4|hydrochloric|sulfuric|clohiđric|clohidric|sunfuric)/i.test(q) || !/\d\s*(?:gam|g|mol|mL)(?!\p{L})/iu.test(q)) return null;
  const metals = [
    { re: /\bZn\b|zinc|kẽm/i, symbol: 'Zn', mass: 65, valence: 2 },
    { re: /\bFe\b|iron|sắt/i, symbol: 'Fe', mass: 56, valence: 2 },
    { re: /\bMg\b|magnesium|magie/i, symbol: 'Mg', mass: 24, valence: 2 },
    { re: /\bAl\b|aluminium|nhôm/i, symbol: 'Al', mass: 27, valence: 3 },
  ].filter(m => m.re.test(q.replace(/\d\s*mg\b/g, '')));
  if (metals.length !== 1 || /hỗn hợp|hiệu suất|tạp chất/i.test(q)) return review('Cần xác định riêng kim loại, độ tinh khiết, hiệu suất và chất giới hạn; không lấy số gam đầu tiên để thay cho mọi chất.');
  const metal = metals[0];
  const sulfate = /H2SO4|sulfuric|sunfuric/i.test(q);
  if (sulfate && (!/loãng/i.test(q) || /đặc/i.test(q))) return review('Chỉ áp dụng phản ứng tạo H₂ với H₂SO₄ loãng. H₂SO₄ đặc có tính oxi hóa; cần điều kiện phản ứng cụ thể.');
  if (sulfate && /HCl|hydrochloric|clohiđric|clohidric/i.test(q)) return review('Đề có nhiều acid; cần xác định thành phần và chất giới hạn.');
  const massMatches = [...q.matchAll(new RegExp(`${numberPattern}\\s*(?:gam|g)\\s+(?:${metal.symbol}\\b|zinc|iron|magnesium|aluminium|kẽm|sắt|magie|nhôm)`, 'giu'))];
  const m = massMatches.length === 1 ? num(massMatches[0][1]) : quantity(q, `m\\s*\\(?${metal.symbol}\\)?`, { g: 1, gam: 1 });
  if (m === null || m <= 0) return review('Chưa xác định được khối lượng kim loại; hãy ghi rõ số gam gắn với tên kim loại.');
  const acid = sulfate ? 'H₂SO₄' : 'HCl';
  const z = metal.valence;
  const ratio = sulfate ? z / 2 : z;
  const salt = sulfate ? (z === 3 ? 'Al₂(SO₄)₃' : `${metal.symbol}SO₄`) : `${metal.symbol}Cl${z === 3 ? '₃' : '₂'}`;
  const eq = sulfate ? (z === 3 ? '2Al + 3H₂SO₄ → Al₂(SO₄)₃ + 3H₂↑' : `${metal.symbol} + H₂SO₄ → ${salt} + H₂↑`)
    : (z === 3 ? '2Al + 6HCl → 2AlCl₃ + 3H₂↑' : `${metal.symbol} + 2HCl → ${salt} + H₂↑`);
  const volumeMatch = q.match(new RegExp(`${numberPattern}\\s*(mL|L|lít)\\s*(?:dung dịch|dd)`, 'iu'));
  const volume = volumeMatch ? num(volumeMatch[1]) * (volumeMatch[2].toLowerCase() === 'ml' ? 0.001 : 1) : null;
  const cMatch = q.match(new RegExp(`${numberPattern}\\s*(?:mol/L|M)(?![\\p{L}\\d])`, 'iu'));
  const concentration = cMatch ? num(cMatch[1]) : null;
  if (volume !== null && volume <= 0 || concentration !== null && concentration <= 0) return review('Thể tích dung dịch và nồng độ phải dương.');
  // Uppercase M denotes molar mass; lowercase m denotes sample mass.
  const givenMass = q.match(new RegExp(`(?:M\\s*\\(\\s*${metal.symbol}\\s*\\)|(?<![\\p{L}\\p{N}])${metal.symbol})\\s*=\\s*${numberPattern}`, 'u'));
  const M = givenMass ? num(givenMass[1]) : metal.mass;
  if (M <= 0) return review('Khối lượng mol phải dương.');
  const n = m / M;
  const acidAvailable = volume !== null && concentration !== null ? volume * concentration : null;
  const complete = /vừa đủ|(?:acid|HCl|H2SO4|axit)(?:\s*\([^)]*\))?\s*(?:loãng\s*)?dư|dư\s+(?:dung dịch|HCl|H2SO4)|tan hết|hòa tan hoàn toàn/i.test(q);
  if (acidAvailable === null && !complete) return review('Chưa biết lượng acid hoặc acid có dư/vừa đủ hay không; chưa thể kết luận toàn bộ kim loại phản ứng.');
  const reacted = acidAvailable === null ? n : Math.min(n, acidAvailable / ratio);
  if (acidAvailable !== null && /vừa đủ/i.test(q) && !close(n * ratio, acidAvailable)) return review('Dữ kiện nồng độ, thể tích acid mâu thuẫn với điều kiện phản ứng vừa đủ.');
  if (acidAvailable !== null && complete && acidAvailable < n * ratio && !close(acidAvailable, n * ratio)) return review('Lượng acid không đủ để toàn bộ kim loại phản ứng, mâu thuẫn với điều kiện acid dư hoặc kim loại tan hết.');
  const h2 = reacted * z / 2;
  const saltN = reacted / (sulfate && z === 3 ? 2 : 1);
  const saltM = sulfate ? (z === 3 ? 2 * M + 3 * 96 : M + 96) : M + z * 35.5;
  const steps = [
    `Dữ kiện: m(${metal.symbol}) = ${fmt(m)} g | M(${metal.symbol}) = ${fmt(M)} g/mol${volume !== null ? ` | V(dd ${acid}) = ${fmt(volume)} L` : ''}`,
    step('Lập và cân bằng phương trình', `[EQ] ${eq}\nĐếm số nguyên tử mỗi nguyên tố ở hai vế để kiểm tra hệ số. Hệ số phương trình biểu diễn tỉ lệ số mol, không phải tỉ lệ khối lượng.`),
    step('Tính số mol kim loại', `[EQ] n_{${metal.symbol}} = \\frac{m_{${metal.symbol}}}{M_{${metal.symbol}}} = \\frac{${fmt(m)}}{${fmt(M)}} = ${fmt(n)} mol`),
    step('Xác định chất giới hạn', acidAvailable !== null
      ? `n(${acid}) ban đầu = ${fmt(concentration!)} × ${fmt(volume!)} = ${fmt(acidAvailable)} mol. Mỗi mol ${metal.symbol} cần ${fmt(ratio)} mol ${acid}.\n[EQ] n_{${metal.symbol},phản ứng} = min(${fmt(n)}; ${fmt(acidAvailable)}/${fmt(ratio)}) = ${fmt(reacted)} mol`
