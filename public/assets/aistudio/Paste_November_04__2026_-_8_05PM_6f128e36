    step('Suy ra số mol sản phẩm', `Theo hệ số phương trình:\n[EQ] n_{H₂} = ${fmt(z / 2)} × ${fmt(reacted)} = ${fmt(h2)} mol\n[EQ] n_{${salt}} = ${fmt(saltN)} mol`),
  ];
  const results: Result[] = [];
  const ask = request(q);
  let warning: string | undefined;
  if (/thể tích|bao nhiêu.*(?:lít|L)/i.test(ask)) {
    const vmMatch = q.match(new RegExp(`(?:Vm|V_m|Vₘ)\\s*=\\s*${numberPattern}\\s*(?:L|lít)/mol`, 'iu'));
    const modern = /đkc|điều kiện chuẩn|25\s*°?\s*C/i.test(q) && !/đktc|tiêu chuẩn/i.test(q);
    const standard = /đktc|điều kiện tiêu chuẩn|0\s*°\s*C/i.test(q);
    const vm = vmMatch ? num(vmMatch[1]) : modern ? 24.79 : standard ? 22.4 : null;
    const explicitOtherConditions = /(?:\d+(?:[.,]\d+)?)\s*(?:°\s*C|bar|atm)/gi;
    const conditions = [...q.matchAll(explicitOtherConditions)].map(m => m[0].replace(/\s/g, '').toLowerCase());
    const conflictingConditions = /đkc|điều kiện chuẩn/i.test(q) && /đktc|điều kiện tiêu chuẩn/i.test(q);
    const supportedConditions = !conflictingConditions && (vmMatch || conditions.every(c => modern ? ['25°c', '1bar'].includes(c) : ['0°c', '1atm'].includes(c)));
    if (vm === null || vm <= 0 || !supportedConditions) warning = 'Cần nhiệt độ, áp suất hoặc thể tích mol khí Vₘ; không tự dùng 24,79 L/mol cho mọi điều kiện.';
    else {
      const V = h2 * vm;
      steps.push(step('Tính thể tích khí', `${vmMatch ? 'Dùng thể tích mol đề cho' : modern ? 'Ở 25°C và 1 bar, Vₘ ≈ 24,79 L/mol' : 'Ở 0°C và 1 atm, Vₘ ≈ 22,4 L/mol'}.\n[EQ] V_{H₂} = n_{H₂} × ${fmt(vm)} = ${fmt(h2)} × ${fmt(vm)} = ${fmt(V)} L`));
      results.push({ value: V, unit: 'L' });
    }
  }
  if (/khối lượng muối/i.test(ask)) {
    steps.push(step('Tính khối lượng muối', `[EQ] m_{${salt}} = n_{${salt}} × M_{${salt}} = ${fmt(saltN)} × ${fmt(saltM)} = ${fmt(saltN * saltM)} g`));
    results.push({ value: saltN * saltM, unit: 'g' });
  }
  if (/nồng độ/i.test(ask)) {
    if (volume === null || !/vừa đủ/i.test(q) || /sau phản ứng|phần trăm/i.test(ask)) warning = 'Chỉ suy ra nồng độ mol acid ban đầu từ lượng kim loại khi acid vừa đủ và biết thể tích dung dịch; yêu cầu khác cần bổ sung dữ kiện.';
    else {
      const c = n * ratio / volume;
      steps.push(step('Tính nồng độ mol acid ban đầu', `Acid vừa đủ: n(${acid}) = ${fmt(ratio)} × ${fmt(n)} = ${fmt(n * ratio)} mol. Thể tích phải đổi sang lít.\n[EQ] C_M = \\frac{n}{V} = \\frac{${fmt(n * ratio)}}{${fmt(volume)}} = ${fmt(c)} mol/L`));
      results.push({ value: c, unit: 'mol/L' });
    }
  }
  steps.push(step('Kiểm tra', `Lượng kim loại phản ứng ${fmt(reacted)} mol không vượt ${fmt(n)} mol ban đầu; acid tiêu thụ là ${fmt(reacted * ratio)} mol. Các giá trị được tính trước khi làm tròn.`));
  return { steps, results, warning };
}

function biologyAndAtoms(q: string): Work | null {
  const zMatch = q.match(/\bZ\s*=\s*([-+]?\d+(?:[.,]\d+)?)/i);
  if (zMatch && /nguyên tử|proton|electron|hạt nhân/i.test(q)) {
    const z = num(zMatch[1]);
    if (!Number.isInteger(z) || z < 1 || z > 20 || /ion|điện tích\s*[+-]|mất|nhận thêm/i.test(q)) return review('Phân bố electron tự động chỉ áp dụng cho nguyên tử trung hòa có Z nguyên từ 1 đến 20; ion và nguyên tố khác cần xét cấu hình riêng.');
    const nMatch = q.match(/(?:\bn|neutron)\s*(?:=|là)\s*([-+]?\d+(?:[.,]\d+)?)/i);
    const n = nMatch ? num(nMatch[1]) : null;
    if (n !== null && (!Number.isInteger(n) || n < 0)) return review('Số neutron phải là số nguyên không âm.');
    const shells = [Math.min(z, 2), Math.min(Math.max(z - 2, 0), 8), Math.min(Math.max(z - 10, 0), 8), Math.max(z - 18, 0)].filter(v => v > 0);
    const steps = [`Dữ kiện: Z = ${z}${n !== null ? ` | n = ${n}` : ''} | Nguyên tử trung hòa`,
      step('Xác định số proton và electron', `Z là số proton. Trung hòa điện nghĩa là điện tích dương bằng độ lớn điện tích âm.\n[EQ] p = e = Z = ${z}`),
      step('Phân bố electron', `Với ${z} electron, phân bố trên các lớp từ trong ra ngoài: ${shells.join(' – ')}. Tổng ${shells.join(' + ')} = ${z}, khớp số electron.`)];
    if (n !== null) steps.push(step('Số khối và khối lượng gần đúng', `[EQ] A = p + n = ${z} + ${n} = ${z + n}\nSố khối A không có đơn vị; khối lượng nguyên tử gần đúng là ${z + n} u (amu), do mỗi nucleon có khối lượng xấp xỉ 1 u.`));
    return { steps, warning: n === null && /neutron|số khối|khối lượng/i.test(request(q)) ? 'Chỉ biết Z chưa xác định được số neutron hoặc số khối; cần thêm thông tin đồng vị.' : undefined };
  }
  if (/DNA|ADN/i.test(q) && /\bN\s*=/i.test(q)) {
    const N = num(q.match(/\bN\s*=\s*([-+]?\d+(?:[.,]\d+)?)/i)?.[1] || 'NaN');
    const A = num(q.match(/\bA\s*=\s*([-+]?\d+(?:[.,]\d+)?)/i)?.[1] || 'NaN');
    if (!/mạch kép|hai mạch/i.test(q) || /một mạch|mạch đơn|%/i.test(q) || !Number.isInteger(A) || N <= 0 || N % 2 !== 0 || A < 0 || A > N / 2) return review('Cần N là tổng nucleotide của cả hai mạch DNA và A là số lượng trên cả phân tử (0 ≤ A ≤ N/2); không thay trực tiếp phần trăm hoặc số liệu một mạch.');
    const G = N / 2 - A;
    return { steps: [`Dữ kiện: DNA mạch kép | N = ${N} nucleotide | A = ${A} nucleotide`,
      step('Nguyên tắc bổ sung', `A bắt cặp T; G bắt cặp C nên A = T = ${A} và G = C.`),
      step('Tìm số nucleotide còn lại', `[EQ] G = C = \\frac{N - 2A}{2} = \\frac{${N} - 2 × ${A}}{2} = ${G}`),
      step('Tính liên kết hydrogen', `Mỗi cặp A–T có 2, mỗi cặp G–C có 3 liên kết hydrogen. A và G ở đây cũng là số cặp tương ứng.\n[EQ] H = 2A + 3G = 2 × ${A} + 3 × ${G} = ${2 * A + 3 * G}`),
      step('Kiểm tra', `A + T + G + C = ${A} + ${A} + ${G} + ${G} = ${N}. Các số lượng đều là số nguyên không âm.`)] };
  }
  // Concept rules are intentionally narrow: a keyword alone is not a solution.
  const concepts: Array<{ when: boolean; answer: string; basis: string; matches: (o: string) => boolean }> = [
    { when: /hạt.*mang điện tích âm/i.test(q) && /hạt nào|là gì/i.test(q), answer: 'Electron', basis: 'Trong mô hình Rutherford – Bohr, electron ở vỏ có điện tích −1e; proton ở hạt nhân mang +1e; neutron không mang điện.', matches: o => /^(?:hạt\s+)?electron(?:\s*\(e\))?\.?$/i.test(o.trim()) },
    { when: /bào quan nào.*quang hợp/i.test(q), answer: 'Lục lạp', basis: 'Lục lạp chứa diệp lục hấp thụ năng lượng ánh sáng để tổng hợp chất hữu cơ từ CO₂ và nước. Ti thể đảm nhiệm hô hấp tế bào, còn nhân lưu giữ thông tin di truyền.', matches: o => /^(?:bào quan\s+)?lục lạp\.?$/i.test(o.trim()) },
    { when: /bào quan nào.*hô hấp tế bào/i.test(q), answer: 'Ti thể', basis: 'Ở tế bào nhân thực, ti thể là nơi diễn ra các giai đoạn hô hấp hiếu khí tạo phần lớn ATP cung cấp năng lượng cho tế bào; lục lạp thực hiện quang hợp.', matches: o => /^(?:bào quan\s+)?ti thể\.?$/i.test(o.trim()) },
  ];
  const concept = concepts.find(c => c.when);
  if (concept && !/không phải|sai|ngoại trừ/i.test(q)) return { steps: [`Dữ kiện: ${q}`, step('Kiến thức cần dùng', concept.basis), step('Áp dụng vào câu hỏi', `Đề hỏi đúng đặc điểm/chức năng nêu trên, nên kết quả là ${concept.answer}. Đối chiếu từng phương án theo đặc điểm này.`)], matches: concept.matches };
  if (/phenolphthalein|quỳ tím/i.test(q) && !/trộn|trung hòa|thêm.*(?:đến|dư)|chuẩn độ/i.test(q)) {
    if (/không phải|không đúng|sai|ngoại trừ|pH\s*[=<>]|nồng độ|mol\/L|\d\s*M\b/i.test(q)) return review('Cần xét chính xác yêu cầu phủ định, pH hoặc nồng độ và khoảng đổi màu chất chỉ thị; không chỉ dựa vào tên acid/base.');
    const acid = /HCl|H2SO4|môi trường acid|môi trường axit/i.test(q);
    const base = /NaOH|KOH|Ca\(OH\)2|môi trường base|môi trường bazơ/i.test(q);
    if (acid === base) return review('Cần xác định môi trường cuối cùng của dung dịch trước khi suy ra màu chất chỉ thị.');
    const phenol = /phenolphthalein/i.test(q);
    const color = phenol ? base ? 'hồng' : 'không màu' : base ? 'xanh' : 'đỏ';
    return { steps: [`Dữ kiện: Chất chỉ thị ${phenol ? 'phenolphthalein' : 'quỳ tím'} | Dung dịch ${base ? 'kiềm' : 'acid'}`,
      step('Xác định môi trường', base ? 'Dung dịch kiềm tạo ion OH⁻ trong nước, có pH > 7 ở khoảng 25°C.' : 'Dung dịch acid tạo ion H⁺ trong nước, có pH < 7 ở khoảng 25°C.'),
      step('Đối chiếu khoảng đổi màu', phenol ? 'Phenolphthalein không màu trong môi trường acid/trung tính và có màu hồng ở vùng kiềm thông thường (khoảng chuyển màu pH 8,2–10).' : 'Quỳ tím hóa đỏ trong môi trường acid và hóa xanh trong môi trường kiềm.'),
      step('Kết luận', `Trong điều kiện thí nghiệm thông thường nêu ở đề, chất chỉ thị có màu ${color}. Không suy ra màu của một chất chỉ thị từ quy tắc của chất chỉ thị khác.`)], matches: o => new RegExp(color, 'i').test(o) && !/không.*hồng|không.*xanh|không.*đỏ/i.test(o) };
  }
  return null;
}

// Match result units as well as values. A wrong answer key must not override a calculation.
const hasUnsupportedArithmetic = (option: string) => /10\s*\^|\d[eE][+-]?\d|\d\s*[/*×÷]\s*[-+]?\d/.test(plain(option));
function matchesResult(option: string, result: Result): boolean {
  if (hasUnsupportedArithmetic(option)) return false;
  const units: Record<string, Record<string, number>> = {
    A: { A: 1, mA: 0.001 }, V: { V: 1, mV: 0.001, kV: 1000 }, Ω: { Ω: 1, kΩ: 1000 },
    W: { W: 1, kW: 1000 }, J: { J: 1, kJ: 1000 }, Pa: { Pa: 1, kPa: 1000 },
    L: { L: 1, lít: 1, ml: 0.001, mL: 0.001 }, g: { g: 1, gam: 1, kg: 1000 },
    'm/s': { 'm/s': 1, 'km/h': 1 / 3.6 }, 'mol/L': { 'mol/L': 1, M: 1 },
  };
  return Object.entries(units[result.unit] || {}).some(([unit, factor]) => {
    const re = new RegExp(`${numberPattern}\\s*${unit.replace('/', '\\/')}(?![\\p{L}\\p{N}/])`, 'gu');
    return [...plain(option).matchAll(re)].some(m => close(num(m[1]) * factor, result.value));
  });
}

export function explanationSteps(text: string): string[] {
  const cleaned = text.trim().replace(/^(?:Lời giải chi tiết|Lời giải từ tài liệu\/giáo viên):\s*\n/i, '').replace(/^[ \t]*[-•*+]\s*/gm, '');
  const explicit = cleaned.split(/\n(?=(?:Dữ kiện\s*:|Bước\s*\d+\s*[:.(]))/i)
    .filter(Boolean);
  if (explicit.some(s => /^(?:Dữ kiện\s*:|Bước\s*\d+)/i.test(s))) return explicit;
  // Keep equations with the paragraph that introduces them; never split decimal numbers.
  return cleaned.split(/\n\s*\n/).filter(Boolean).map((s, i) => `Bước ${i + 1}: ${s}`);
}

export function generateScientificSolution(input: SolutionInput): ScientificSolution {
  const q = plain(input.question);
  const work = electrical(q) || mechanics(q) || chemistry(q) || biologyAndAtoms(q);
  const essay = input.questionType === 'essay' || input.options.length === 0;
  const key = input.correctAnswer ?? -1;
  const hasKey = Number.isInteger(key) && key >= 0 && key < input.options.length;
  const unparsedOption = Boolean(work?.results?.length && input.options.some(hasUnsupportedArithmetic));
  const matches = work && !work.warning && !unparsedOption ? input.options.flatMap((o, i) => (work.matches?.(o) || work.results?.length && work.results.every(r => matchesResult(o, r))) ? [i] : []) : [];
  const inferredAnswer = matches.length === 1 ? matches[0] : null;
  const warnings: string[] = [];
  const provided = input.existingExplanation?.trim();
  if (unparsedOption) warnings.push('Phương án chứa biểu thức số chưa được tính tự động; cần viết kết quả số kèm đơn vị để đối chiếu chính xác.');
  if (provided && !essay && hasKey) {
    // Only an affirmative conclusion starts after a sentence/step delimiter.
    // Mentions such as "không chọn A" or "loại đáp án A" are not conclusions.
    const conclusions = [...provided.matchAll(/(?:^|[\n:;.!?⇒]\s*)(?:(?:vậy|do đó|nên|suy ra)\s+)?(?:chọn(?:\s+đáp\s+án)?|đáp\s+án(?:\s+đúng)?(?:\s+là)?)\s+([A-D])(?!\p{L})/giu)];
    if (conclusions.some(m => m[1].toUpperCase().charCodeAt(0) - 65 !== key)) warnings.push('Kết luận chọn đáp án trong lời giải gốc khác với đáp án đang chọn. Cần sửa hoặc kiểm tra lại lời giải gốc.');
  }
  if (work?.warning && !provided) warnings.push(work.warning);
  if (!essay && inferredAnswer !== null && hasKey && key !== inferredAnswer) warnings.push(`Đáp án đã chọn ${String.fromCharCode(65 + key)} mâu thuẫn với kết quả tính/kiến thức (${String.fromCharCode(65 + inferredAnswer)}). Hãy kiểm tra đề và đáp án.`);
  if (!essay && !hasKey && inferredAnswer === null) warnings.push('Chưa xác định được đáp án đúng; giáo viên cần chọn đáp án, không mặc định phương án A.');
  if (!essay && work && !work.warning && (work.matches || work.results?.length) && inferredAnswer === null) warnings.push('Chưa có một phương án duy nhất khớp kết quả và đơn vị; kiểm tra phương án, quy tắc làm tròn hoặc dữ kiện.');
  if (!essay && work && !work.warning && !work.matches && !work.results?.length && !provided) warnings.push('Đã lập các bước tính nhưng chưa đối chiếu được phương án; cần giáo viên bổ sung kết luận chính xác.');
  if (!provided && !work) warnings.push('Chưa có quy tắc giải đủ tin cậy cho câu này. Cần bổ sung lời giải hoặc đáp án mẫu từ giáo viên; không suy diễn lời giải chỉ từ phương án được chọn.');
  let steps: string[];
  if (provided) steps = explanationSteps(provided);
  else {
    const raw = work?.steps.length ? work.steps : [`Dữ kiện: ${input.question}`, step('Nội dung cần bổ sung', warnings.join(' '))];
    let index = 0;
    steps = raw.map(s => s.startsWith('Dữ kiện:') ? s : `Bước ${++index}: ${s}`);
    if (!essay && inferredAnswer !== null && !warnings.length) {
      const comparisons = input.options.map((option, i) => {
        const label = String.fromCharCode(65 + i);
        if (i === inferredAnswer) return `${label}. ${option}: khớp ${work?.results?.length ? 'kết quả và đơn vị đã tính' : 'đặc điểm khoa học đã phân tích'}.`;
        const unmatched = work?.results?.filter(result => !matchesResult(option, result));
        return unmatched?.length
          ? `${label}. ${option}: không khớp kết quả cần tìm ${unmatched.map(result => `${fmt(result.value)} ${result.unit}`).join('; ')} (sau khi đổi về cùng đơn vị).`
          : `${label}. ${option}: không đáp ứng đặc điểm cần tìm đã nêu ở bước phân tích.`;
      });
      steps.push(`Bước ${++index}: Đối chiếu từng phương án:\n${comparisons.join('\n')}\nKết luận: Chọn ${String.fromCharCode(65 + inferredAnswer)}.`);
    }
  }
  const status = warnings.length ? 'needs_review' : provided ? 'provided' : 'solved';
  const header = status === 'needs_review' ? 'Hướng dẫn cần giáo viên kiểm tra:' : provided ? 'Lời giải từ tài liệu/giáo viên:' : !essay && inferredAnswer !== null ? `Đáp án đúng là ${String.fromCharCode(65 + inferredAnswer)} (${input.options[inferredAnswer]}).` : 'Lời giải chi tiết:';
  return { steps, status, warnings, inferredAnswer, explanation: `${header}\n${steps.join('\n')}${warnings.length ? `\nLưu ý kiểm tra: ${warnings.join(' ')}` : ''}` };
}

